<mah:MetroWindow xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:controlzex="urn:controlzex" 
                 xmlns:svgc1="http://sharpvectors.codeplex.com/svgc/" 
                 x:Class="testapps.Window1"
               
                 Title="TaskHive"
                 Width="900"
                 Height="950"
                 WindowStartupLocation="CenterScreen"  x:Name="MainForm"  Background="#FF2D2D2D" WindowState="Maximized" Loaded="MainForm_Loaded" ContentRendered="MainForm_ContentRendered" Closed="MainForm_Closed">

    <Window.Resources>
        <Style x:Key="GridColumnsStyle" TargetType="DataGridColumnHeader">



        </Style>

        <Style x:Key="TopTextboxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </Window.Resources>


    <Grid x:Name="Go">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <Grid x:Name="GridnMenu" Grid.Row="0" >
            <Menu x:Name="Menu1" >
                <MenuItem x:Name="MenuItem_File" Header="{x:Static lang:Strings.File}">

                    <MenuItem x:Name="MenuAM" Header="{x:Static lang:Strings.ApplicantManagement}" Click="Manage_Customer_Click" />
                    <MenuItem x:Name="MenuMC" Header="{x:Static lang:Strings.ManageCompany}" Click ="Manage_Company_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuItem_backup" Header="{x:Static lang:Strings.Backup}" Click="MenuItem_Click"  />
                    <MenuItem x:Name="MenuItem_Restore" Header="{x:Static lang:Strings.Restore}" Click="MenuItem_Click_1" />
                    <Separator/>
                    <MenuItem x:Name="MenuItem_tasks" Header="{x:Static lang:Strings.Task_Management}" Click="MenuItem_tasks_Click"  />


                </MenuItem>
                <MenuItem x:Name="MenuItem_Security" Header="{x:Static lang:Strings.Security}" >
                    <MenuItem x:Name="MenuMU" Header="{x:Static lang:Strings.ManageUser}" Click="Manage_User_Click" />
                    <MenuItem x:Name="MenuLock" Header="{x:Static lang:Strings.User_Login_Mode}" Click="MenuLock_Click"  />

                </MenuItem>
                <MenuItem x:Name="MenuItem_Tools" Header="{x:Static lang:Strings.Tools}">
                    <MenuItem x:Name="MenuRminder" Header="{x:Static lang:Strings.Reminder}" Click="Manage_Reminder_Click" />
                    <MenuItem x:Name="Menudeviceconnect" Header="{x:Static lang:Strings.Establishconnectiondevice}" Click="Menudeviceconnect_Click" />
                    <MenuItem x:Name="MenuCalling" Header="{x:Static lang:Strings.CallMessageForm}" Click="Manage_Calling_Click" />
                    <MenuItem x:Name="MenuNavigate" Header="{x:Static lang:Strings.navigate}" Click="MenuNavigate_Click"  />
                    <MenuItem x:Name="MenuPDF" Header="{x:Static lang:Strings.PDF}" Click="MenuPDF_Click" />
                    <MenuItem x:Name="Menushare" Header="{x:Static lang:Strings.File_Transfer}" Click="Menushare_Click"  />
                    <MenuItem x:Name="Menuweather" Header="{x:Static lang:Strings.WeatherStatus}" Click="Menuweather_Click" />

                </MenuItem>
                <MenuItem x:Name="MenuItem_Setting" Header="{x:Static lang:Strings.Settings}">
                    <MenuItem x:Name="Menuoffice" Header="{x:Static lang:Strings.BasicInformation}" Click="Menuoffice_Click"  />
                </MenuItem>
                <MenuItem x:Name="MenuInternet" Header="{x:Static lang:Strings.webapplication}"  >
                    <MenuItem x:Name="MenuInternetLogin" Header="Create Account" Click="MenuInternetLogin_Click"  />
                    <MenuItem x:Name="Menusendmessage" Header="{x:Static lang:Strings.Sendmessageuser}" Click="Menusendmessage_Click"  />
                </MenuItem>
            </Menu>
        </Grid>


        <Grid x:Name="Gtop" Grid.Row="1">

            <DockPanel  >
                <ToolBarTray DockPanel.Dock="Top" Background="#FF373737"  IsLocked="True" >
                    <ToolBar x:Name="toolbar1" Background="#FF373737" AllowDrop="False" Width="600">



                        <ComboBox x:Name="ComboboxLanguage" Width="130" Height="30" Margin="5" Background="#FF373737" BorderBrush="#FF373737" Foreground="#FFE2E2E2" SelectedIndex="0" SelectionChanged="ComboBox_SelectionChanged" >

                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/usa.png" Width="24" Height="19"/>
                                    <TextBlock Text="United States" Foreground="White" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>

                            <ComboBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/fin.png" Width="24" Height="19"/>
                                    <TextBlock Text="Finland" Foreground="White" Margin="5,0,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>

                        </ComboBox>

                        <Line  X1="0" Y1="50" X2="0" Y2="0" Stroke="#FF4E4E4E" StrokeThickness="2" Fill="#FF4E4E4E" Margin="5,0,0,0"/>


                        <Button x:Name="btnsetting" Margin="5,0,0,0" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444" Click="btnsetting_Click"/>



                        <Button x:Name="btnuser" Margin="5,0,0,0" Content="&#xE785;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444" Click="btnuser_Click"/>
                        <Line  X1="0" Y1="50" X2="0" Y2="0" Stroke="#FF4E4E4E" StrokeThickness="2" Fill="#FF4E4E4E" Margin="5,0,0,0"/>

                        <Button x:Name="BtnConnectDevice" Margin="5,0,0,0" Content="&#xEA6C;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444" Click="BtnConnectDevice_Click"/>
                        <Button x:Name="BtnPDF" Margin="5,0,0,0" Content="&#xEA90;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444"  Click="BtnPDF_Click"/>
                        <Button x:Name="Btnoffice" Margin="5,0,0,0" Content="&#xF61B;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444"  Click="BtnOffice_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="WORD" Click="MenuItem_Word_Click"/>
                                    <MenuItem Header="EXCEL" Click="MenuItem_Excel_Click"/>
                                    <MenuItem Header="Office 365" Click="MenuItem_Office_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="Btnjob" Margin="5,0,0,0" Content="&#xE779;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444"  Click="Btnjob_Click"/>
                        <Button x:Name="BtnShareFolder" Margin="5,0,0,0" Content="&#xF89A;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444"  Click="Btnshare_Click"/>
                        <Button x:Name="BtnNavigate" Margin="5,0,0,0" Content="&#xEB4A;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444"  Click="Btnnavigate_Click"/>
                        <Button x:Name="BtnWeather" Margin="5,0,0,0" Content="&#xE753;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444" Click="BtnWeather_Click" />

                    </ToolBar>
                </ToolBarTray>

            </DockPanel>

        </Grid>


        <Grid x:Name="Gbody" Grid.Row="2">

            <TabControl x:Name="TabControlLeft" 
            TabStripPlacement="Left" 
            Background="#FF373737" 
            Margin="0,10,10,20" BorderBrush="#FF2F2F2F" >

                <TabControl.Resources>

                    <Style TargetType="{x:Type TabItem}">

                        <Setter Property="Background" Value="#FF2D2D2D"/>
                        <Setter Property="Foreground" Value="LightGray"/>
                        <Setter Property="BorderBrush" Value="#FF383838"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="20"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Background" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <TabItem x:Name="Email" Header="{x:Static lang:Strings.Email}">
                    <Wpf:WebView2 x:Name="WebviewEmail"/>
                </TabItem>
                <TabItem x:Name="WhatsApp" Header="{x:Static lang:Strings.WhatsApp}">
                    <Wpf:WebView2 x:Name="WebviewWhatsApp"/>
                </TabItem>
                <TabItem x:Name="Telegram" Header="{x:Static lang:Strings.Telegram}">
                    <Wpf:WebView2 x:Name="WebviewTelegram"/>
                </TabItem>
                <TabItem x:Name="MyWebsite" Header="{x:Static lang:Strings.MyWebsite}">
                    <Wpf:WebView2 x:Name="Websiteoffice"/>
                </TabItem>
                <TabItem x:Name="PDF" Header="{x:Static lang:Strings.PDF}">
                    <Wpf:WebView2 x:Name="WebviewPDF"/>
                </TabItem>
                <TabItem x:Name="GoogleMap" Header="{x:Static lang:Strings.GoogleMap}" LostFocus="GoogleMap_LostFocus">
                    <Wpf:WebView2 x:Name="WebvieweGoogleMap"/>
                </TabItem>

                <TabItem x:Name="Office" Header="{x:Static lang:Strings.Office}">
                    <Wpf:WebView2 x:Name="WebvieweOffice"/>
                </TabItem>

                <TabItem x:Name="Office365" Header="{x:Static lang:Strings.office365}">
                    <Wpf:WebView2 x:Name="WebvieweOffice365"/>
                </TabItem>

                <TabItem x:Name="TaskList" Header="{x:Static lang:Strings.tasklist}">

                    <Grid Background="#333">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="55"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>


                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0"  VerticalAlignment="Top" Margin="20,10,20,0">

                            <Button x:Name="btnshownotify"  Height="30" Content="{x:Static lang:Strings.ViewNotifications}"  Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" Margin="3,0,3,0" Click="btnshownotify_Click"/>
                            <Button x:Name="btnsCustomerEmail"  Height="30" IsEnabled="False" Content="{x:Static lang:Strings.Email}" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" Margin="3,0,3,0" Click="btnsCustomerEmail_Click"/>

                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,10,20,0">
                            <Button x:Name="btnCompanyWebsit" Width="80" Height="30" Content="{x:Static lang:Strings.Website}" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" IsEnabled="False" Click="btnCompanyWebsit_Click" />
                            <Button x:Name="btnemail" Width="110" Height="30" Content="{x:Static lang:Strings.Email}" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" IsEnabled="False" Margin="3,0,3,0" Click="btnemail_Click" />
                            <Button x:Name="btnshowongoing"  Height="30" IsEnabled="True" Content="{x:Static lang:Strings.Ongoing}" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" Margin="3,0,3,0" Click="btnshowongoing_Click"  />
                            <Button x:Name="btnCompleted"  Height="30" IsEnabled="True" Content="{x:Static lang:Strings.Completed}" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" Margin="3,0,3,0" Click="btnCompleted_Click"  />

                        </StackPanel>


                        <Grid Grid.Row="1" Grid.Column="0"  >

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="180"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="15"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Vertical"  Grid.Row="0" Grid.Column="0" >
                                <Image x:Name="img" Width="150" Height="145"   VerticalAlignment="Center" HorizontalAlignment="Left"  Stretch="Fill" Margin="20" Source="/user.png" />
                            </StackPanel>


                            <StackPanel Orientation="Vertical"  Grid.Row="0" Grid.Column="1"  Margin="5,0,0,0">
                                <TextBox x:Name="txtid" Text="---" Margin="0,0,0,5" IsReadOnly="True" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" />
                                <TextBox x:Name="txtfullname" Text="---" Margin="0,10,0,5" IsReadOnly="True" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" />
                                <TextBox x:Name="txtcustomeremail" Text="---"  IsReadOnly="True" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" />
                                <ComboBox x:Name="combophone" SelectedIndex="0" Margin="0,0,0,5" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" />
                                <TextBox x:Name="txtaddress" Text="---" Margin="0,0,0,5" IsReadOnly="True" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <Label  Content="{x:Static lang:Strings.Time}" Foreground="White"  Margin="20,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Label x:Name="labeltime"  Content="00:00" Foreground="White"  Margin="20,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            </StackPanel>

                            <Label x:Name="labelServiceStatus" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Content="{x:Static lang:Strings.ServiceStatus}" Foreground="White" Margin="20,0,0,5"/>
                            <TextBox x:Name="txtserbicetype" Grid.Row="2" Grid.Column="0"  Grid.ColumnSpan="2" Text="" Margin="20,20,0,5" VerticalAlignment="Center" IsReadOnly="True" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" />
                            <Label x:Name="labeldescription" Content="{x:Static lang:Strings.description}" Grid.Row="3" Grid.Column="0" Foreground="White" Margin="20,0,0,0"/>
                            <TextBox x:Name="txtdes" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,30,0,20" Text="" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" />



                        </Grid>



                        <Grid x:Name="gridcompany" Grid.Row="1" Grid.Column="1" Margin="20" >

                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="55"/>
                            </Grid.RowDefinitions>

                            <Label x:Name="labelselectreuest" Grid.Row="0" Content="{x:Static lang:Strings.selectrequest}" Foreground="White"/>


                            <StackPanel Orientation="Horizontal" Grid.Row="1">
                                <Label x:Name="LableCompanyName"  Foreground="Gray" Content="{x:Static lang:Strings.companyname}" VerticalAlignment="Center"/>
                                <Button x:Name="btnselectcompany"  Margin="60,0,0,0" Width="120" Height="30" Content="{x:Static lang:Strings.CompanySelection}" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" IsEnabled="False" Click="btnselectcompany_Click"/>
                            </StackPanel>

                            <TextBox x:Name="txtparty" Grid.Row="1" IsReadOnly="True" VerticalAlignment="Center" Margin="280,0,0,0" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" />



                            <Label x:Name="labelcompanyaddress" Grid.Row="2" Foreground="Gray" Content="{x:Static lang:Strings.CompanyAddress}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtcompanyaddress" Text="---" Grid.Row="2" VerticalAlignment="Center" Margin="150,0,0,0" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" ></TextBox>

                            <Label x:Name="labelcompanywebsite" Grid.Row="3" Foreground="Gray" BorderBrush="#555" Background="#333" Content="{x:Static lang:Strings.companywebsite}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtcompanywebsite" Grid.Row="3" Text="https://" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" VerticalAlignment="Center" Margin="150,0,0,0" ></TextBox>

                            <Label x:Name="labelcompanyphone" Grid.Row="4" Foreground="Gray" Content="{x:Static lang:Strings.companyphone}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="comboboxcompanyphone" Grid.Row="4" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" VerticalAlignment="Center" Margin="150,0,0,0"  SelectedIndex="0"/>

                            <Label x:Name="Labelcompanyemail" Grid.Row="5" Foreground="Gray" Content="{x:Static lang:Strings.EmailCompany}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtcompanyemail" Grid.Row="5" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" VerticalAlignment="Center" Margin="150,0,0,0" IsReadOnly="True" />



                            <Label x:Name="labelcompanyservice" Grid.Row="6" Foreground="Gray" Content="{x:Static lang:Strings.ServiceType}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtcompanyservice" Grid.Row="6" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" Text="---" VerticalAlignment="Center" Margin="150,0,0,0" IsReadOnly="True" ></TextBox>

                            <Label x:Name="labelcompanynote" Grid.Row="7" Foreground="Gray" Content="{x:Static lang:Strings.Notes}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtcompanynote" Grid.Row="8" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" Text="---"  Margin="0,10,0,10" IsReadOnly="True" VerticalScrollBarVisibility="Visible" ></TextBox>

                            <StackPanel Orientation="Horizontal" Grid.Row="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,20,20">
                                <Button x:Name="btnsavejob" Width="80" Height="30" Content="{x:Static lang:Strings.Save}" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" IsEnabled="False" Click="btnsavejob_Click" />
                                <Button x:Name="btnCancelJob" Width="110" Height="30" Content="{x:Static lang:Strings.Cancel}" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" IsEnabled="False" Margin="3,0,3,0" Click="btnCancelJob_Click" />
                            </StackPanel>

                        </Grid>

                        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Background="#222" >
                            <Label x:Name="laberlstatus1" Content="{x:Static lang:Strings.Youhave}" Foreground="Gray"/>
                            <Button x:Name="BtnNotification" Width="25" Height="25" Cursor="Hand" Background="#222"
                             Foreground="Red" Content="0">

                                <Button.Template>


                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="{TemplateBinding Background}" Stroke="Gray" StrokeThickness="1"/>

                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Label x:Name="laberlstatu2" Content="{x:Static lang:Strings.Notification}" Foreground="Gray"/>
                        </StatusBar>

                    </Grid>






                </TabItem>

                <TabItem x:Name="TabWeather" Header="{x:Static lang:Strings.Weather_conditions}" LostFocus="TabWeather_LostFocus">
                    <Wpf:WebView2 x:Name="WebvieweWeather"/>
                </TabItem>


            </TabControl>


        </Grid>

        <Grid x:Name="Gdown" Grid.Row="3">

            <StackPanel Orientation="Vertical" Width="200" HorizontalAlignment="Right">
                <Label x:Name="Label_date" Height="25" Content="2026/01/16" Foreground="LightGreen" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,-2,0,0" />
                <Label x:Name="Label_Time" Height="25" Content="10:12" Foreground="LightGreen" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,-3,0,0" />
            </StackPanel>

            <DockPanel>

                <StatusBar Background="Transparent" Margin="30,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/logo.png" Height="45" Width="50" />
                    </StackPanel>
                </StatusBar>

                <StackPanel Orientation="Vertical"  HorizontalAlignment="Left" Margin="25,0,0,0">
                    <TextBlock Text="TASKHIVE" Height="25" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" FontSize="20" FontWeight="Bold" Foreground="#FF6B6B6B"/>
                </StackPanel>

                <Line x:Name="line1" X1="0" Y1="0" X2="0" Y2="50" Stroke="#FF4E4E4E" StrokeThickness="2" Fill="#FF4E4E4E" Margin="5,0,0,0"/>

                <StackPanel Orientation="Vertical" Background="#FF2D2D2D" >

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="lab_username" Height="25" Content="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,-2,0,0" />
                        <TextBlock x:Name="TextBoxStatusUsername"  Foreground="Gray" Margin="10,1,5,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Background="#FF2D2D2D" >
                        <Label x:Name="lab_Email" Height="25" Content="&#xE715;" FontFamily="Segoe MDL2 Assets" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,-2,0,0" />
                        <TextBlock x:Name="TextBoxStatusEmail" Foreground="Gray" Margin="10,1,5,0"/>
                    </StackPanel>


                </StackPanel>


                <Line x:Name="line2" X1="0" Y1="0" X2="0" Y2="50" Stroke="#FF4E4E4E" StrokeThickness="2" Fill="#FF4E4E4E" Margin="7,0,0,0"/>

                <StackPanel Orientation="Vertical" Width="230" HorizontalAlignment="Left" Margin="5,0,0,0" >
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="lab_dev" Height="25" Content="&#xEC16;" FontFamily="Segoe MDL2 Assets" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,-2,0,0" />
                        <Label x:Name="Label_PNC" Height="25" Content="{x:Static lang:Strings.Nodeviceconnected}" Foreground="Gray" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,-3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="Lable_status"  Height="25" Content="&#xEC05;" FontFamily="Segoe MDL2 Assets" Foreground="Red" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,-2,0,0" />
                        <Label x:Name="Label_Internet" Height="25" Content="{x:Static lang:Strings.Internetdisconnected}"  Foreground="Gray" VerticalAlignment="Center" Margin="7,-2,0,0"  />
                    </StackPanel>
                </StackPanel>

            </DockPanel>

        </Grid>

    </Grid>


</mah:MetroWindow>
