<mah:MetroWindow
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 mc:Ignorable="d" x:Name="WinUser" x:Class="testapps.Views.WinUsers"
                 Title=""
                 Width="500"
                 Height="400"
                 WindowStartupLocation="CenterScreen" FontSize="14" Loaded="WinUser_Loaded" Background="#FF444444"  ResizeMode="NoResize">

    <Grid Background="#FF4A4A4A" Margin="20" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0"  Margin="10" Text="{x:Static lang:Strings.Phone}" Foreground="White" FontSize="14"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PhoneTextBox" Margin="10" Background="#FF3A3A3A" Foreground="#FFBBBBBB" BorderBrush="#FF2F2F2F" FontSize="14" PreviewTextInput="PhoneTextBox_PreviewTextInput" MaxLength="15" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="10" Text="{x:Static lang:Strings.UserName}" Foreground="White" FontSize="14"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UserNameTextBox" MaxLength="25" Margin="10" Background="#FF3A3A3A" BorderBrush="#FF2F2F2F" FontSize="14" Foreground="#FFBBBBBB"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="10" Text="{x:Static lang:Strings.Email}" Foreground="White" FontSize="14"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="EmailTextBox" MaxLength="50" Margin="10" Background="#FF3A3A3A" BorderBrush="#FF2F2F2F" FontSize="14" Foreground="#FFBBBBBB" TextChanged="EmailTextBox_TextChanged"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="10" Text="{x:Static lang:Strings.TelegramID}" Foreground="White" FontSize="14"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TelegramIdTextBox" MaxLength="15" Text="@" Margin="10" Background="#FF3A3A3A" BorderBrush="#FF2F2F2F" FontSize="14" Foreground="#FFBBBBBB" PreviewTextInput="TelegramIdTextBox_PreviewTextInput" PreviewKeyDown="TelegramIdTextBox_PreviewKeyDown" GotFocus="TelegramIdTextBox_GotFocus"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="10" Text="{x:Static lang:Strings.DeviceNumber}" Foreground="White" FontSize="14"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="DeviceIdTextBox" Margin="10" Text="Null" IsEnabled="False" Background="#FF3A3A3A" BorderBrush="#FF2F2F2F" FontSize="14" Foreground="#FFBBBBBB"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="10" Text="{x:Static lang:Strings.password}" Foreground="White" FontSize="14"/>
        <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="PasswordBox" Margin="10" Background="#FF3A3A3A" BorderBrush="#FF2F2F2F" FontSize="14" Foreground="#FFBBBBBB" MaxLength="12"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Margin="0,29,23,-29">
            <Button x:Name="btnadd" Content="{x:Static lang:Strings.Add}" Width="80" Height="25" Margin="5" Click="Button_Click_1"/>
            <Button Content="{x:Static lang:Strings.Cancel}" Width="100" Height="25" Margin="5" Click="Button_Click"/>
        </StackPanel>
    </Grid>


</mah:MetroWindow>