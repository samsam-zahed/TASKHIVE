<mah:MetroWindow x:Class="testapps.Views.WinNotify"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                
             Width="500"
    Height="150"
    ShowTitleBar="False"
    ShowCloseButton="False"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="#333"
    Topmost="True">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock FontFamily="Segoe MDL2 Assets"  Text="&#xE7BA;"  FontSize="24" Foreground="Orange" Margin="20,10,0,0"/>
            <Label Content="{x:Static lang:Strings.Notification}" Foreground="White" VerticalAlignment="Center" Margin="10,10,0,0"/>
        </StackPanel>
        <Separator Grid.Row="1" VerticalAlignment="Top" Margin="20,0,20,0"/>
        <TextBlock Grid.Row="1" FontFamily="Segoe MDL2 Assets"  Text="&#xEBDB;" VerticalAlignment="Center" HorizontalAlignment="Left"  FontSize="24" Foreground="White" Margin="20,10,0,0"/>

        <TextBlock x:Name="txt"
                   FontSize="16"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left" Foreground="White" Grid.Row="1"  Margin="55,5,0,0"/>

    </Grid>
    
    
</mah:MetroWindow>
