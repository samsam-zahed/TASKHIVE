<mah:MetroWindow
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 mc:Ignorable="d" x:Name="WinUser" x:Class="testapps.Views.WinLogin"
                 Title=""
                 Width="800"
                 Height="450"
                 WindowStartupLocation="CenterScreen" FontSize="14" Background="#FF373737"  ResizeMode="NoResize">


    <Grid Background="#FF373737" Margin="20" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="580"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="1" Grid.Column="0" Height="30" Margin="15,0,0,0"  Text="{x:Static lang:Strings.UserName}" Foreground="White" FontSize="14" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UserNameTextBox" Text="user1" MaxLength="25"  Background="#FF3A3A3A" BorderBrush="#FF2F2F2F" FontSize="14" Foreground="#FFBBBBBB" Height="30"  />

        <TextBlock Grid.Row="2" Grid.Column="0" Height="30" Margin="15,0,0,0" Text="{x:Static lang:Strings.password}" Foreground="White" FontSize="14"/>
        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Password="ww@ww123"  Background="#FF3A3A3A" BorderBrush="#FF2F2F2F" FontSize="14" Foreground="#FFBBBBBB" MaxLength="12" Height="30" KeyDown="PasswordBox_KeyDown"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Height="30" Margin="15,0,0,0"  Text="{x:Static lang:Strings.Email}" Foreground="White" FontSize="14"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="EmailTextBox" MaxLength="50"  Background="#FF3A3A3A" BorderBrush="#FF2F2F2F" FontSize="14" Foreground="#FFBBBBBB" Height="30" IsEnabled="False"/>
        <CheckBox x:Name="checkbox1" Grid.Row="4" Grid.Column="1" Height="30" Content="{x:Static lang:Strings.ForgotPass}" Margin="15,0,0,0" Foreground="WhiteSmoke" Checked="checkbox1_Checked" Unchecked="checkbox1_Unchecked"/>




        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Left" Grid.Column="1"  Width="370" Margin="169,21,0,-21">
            <Button x:Name="btnlogin" Content="{x:Static lang:Strings.login}" Width="200" Height="30" Margin="5" Click="btnlogin_Click" />
            <Button Content="{x:Static lang:Strings.Cancel}" Width="150" Height="30" Margin="5" Click="Button_Click" />
        </StackPanel>
        
    </Grid>






</mah:MetroWindow>