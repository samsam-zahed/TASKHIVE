<mah:MetroWindow xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 x:Class="testapps.Views.WinDevice"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="850"
                 Height="350"
                 WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="MetroWindow_Loaded"  >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TextBlock TextWrapping="Wrap" Text="{x:Static lang:Strings.devicedes}" Foreground="White" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Margin="25,34,41,6"/>

        <Button x:Name="btnruncmd" Grid.Column="2" Grid.Row="1" Width="90" Height="28" Content="{x:Static lang:Strings.Run}" HorizontalAlignment="Right" Margin="0,0,80,0" Click="btnruncmd_Click" />

        <TextBlock TextWrapping="Wrap" Foreground="White" Text="{x:Static lang:Strings.deviceisnotconnect}" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="90,23,285,18" />


        <Button x:Name="btnInstall" Grid.Column="2" Grid.Row="2" Width="90" Height="28" Content="{x:Static lang:Strings.Install}" HorizontalAlignment="Right" Margin="0,0,80,0" Click="btnInstall_Click" />

        <TextBlock TextWrapping="Wrap" Foreground="White" Text="{x:Static lang:Strings.InstallSKK}" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Margin="90,23,285,18" />

        
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,20">
            <Button x:Name="btnsave" Width="90" Height="28" Content="{x:Static lang:Strings.connect}" Margin="0,0,10,0" Click="btnsave_Click"/>
            <Button x:Name="btncancel" Width="110" Height="28" Content="{x:Static lang:Strings.Cancel}" Click="btncancel_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
