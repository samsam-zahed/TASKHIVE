<mah:MetroWindow x:Class="testapps.Views.WinCalendar"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:testapps"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="600"
                 Height="700"
                 WindowStartupLocation="CenterScreen" Loaded="MetroWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBox x:Name="TextboxYear" Width="150" VerticalAlignment="Center" FontSize="20" Foreground="Gray"/>

            <TextBox x:Name="TextboxMonth" Width="150" VerticalAlignment="Center" FontSize="20" Foreground="Gray" KeyDown="TextboxMonth_KeyDown"/>
            <Button x:Name="btn" Content="showcell" Foreground="White" Click="btn_Click"/>
        </StackPanel>


        <DataGrid x:Name="DataGridCalendar" ItemsSource="{Binding CalendarRows}" 
                  AutoGenerateColumns="False" 
                  Grid.Row="2" SelectionUnit="Cell" 
                  SelectionMode="Extended" IsReadOnly="True" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False" 
                  GridLinesVisibility="None" 
                  HeadersVisibility="All" 
                  Margin="10"  
                  VirtualizingStackPanel.IsVirtualizing="False" 
                  CanUserResizeRows="False" MouseDoubleClick="DataGridCalendar_MouseDoubleClick">
            
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#444"/>
                    <Setter Property="Foreground" Value="DarkGray"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="#666"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Height" Value="65"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            
            <DataGrid.RowStyle>
                
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Height" Value="160"/>
                    

                </Style>
                
            </DataGrid.RowStyle>
            
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Width" Value="200"/>
                    <Setter Property="BorderBrush" Value="Gray"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Mon">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6">
                                <StackPanel>

                                   
                                    <TextBlock Text="{Binding Mon.DayNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="26"/>
                                                <Style.Triggers>
                                                 
                                                    <DataTrigger Binding="{Binding Mon.DayNumber}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                              
                                    <TextBlock x:Name="textbox1" Text="{Binding Mon.EventCount, StringFormat=Event({0})}" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Tue">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6">
                                <StackPanel>


                                    <TextBlock Text="{Binding Tue.DayNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="26"/>
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Tue.DayNumber}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>


                                    <TextBlock Text="{Binding Tue.EventCount, StringFormat=Event({0})}" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Wed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6">
                                <StackPanel>


                                    <TextBlock Text="{Binding Wed.DayNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="26"/>
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Wed.DayNumber}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>


                                    <TextBlock Text="{Binding Wed.EventCount, StringFormat=Event({0})}" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Thu">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6">
                                <StackPanel>


                                    <TextBlock Text="{Binding Thu.DayNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="26"/>
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Thu.DayNumber}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>


                                    <TextBlock Text="{Binding Thu.EventCount, StringFormat=Event({0})}" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Fri">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6">
                                <StackPanel>


                                    <TextBlock Text="{Binding Fri.DayNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="26"/>
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Fri.DayNumber}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>


                                    <TextBlock Text="{Binding Fri.EventCount, StringFormat=Event({0})}" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Sat">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6">
                                <StackPanel>


                                    <TextBlock Text="{Binding Sat.DayNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="26"/>
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Sat.DayNumber}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>


                                    <TextBlock Text="{Binding Sat.EventCount, StringFormat=Event({0})}" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Sun">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6">
                                <StackPanel>


                                    <TextBlock Text="{Binding Sun.DayNumber}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontSize" Value="26"/>
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Sun.DayNumber}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="Text" Value=""/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>


                                    <TextBlock Text="{Binding Sun.EventCount, StringFormat=Event({0})}" FontSize="14" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


            </DataGrid.Columns>
            
            
            
        </DataGrid>





    </Grid>



</mah:MetroWindow>
