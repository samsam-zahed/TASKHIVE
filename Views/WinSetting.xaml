<mah:MetroWindow
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 mc:Ignorable="d" x:Name="WInSetting1" x:Class="testapps.Views.WinSetting"
                 Title=""
                 Width="900"
                 Height="570"
                 WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="WInSetting1_Loaded">
    <Grid Background="#FF2F2F2F">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <TextBlock HorizontalAlignment="Left" Grid.Row="0" Text="{x:Static lang:Strings.officedes}" VerticalAlignment="Center" Margin="20,10,0,0" Foreground="#FFC3C3C3"/>


        <TextBlock HorizontalAlignment="Left" Grid.Row="1" Margin="20,10,0,0" TextWrapping="Wrap" Text="{x:Static lang:Strings.OfficeName}" VerticalAlignment="Top" Foreground="#FFC3C3C3" />
        <TextBox x:Name="companyName" Grid.Row="1"   Margin="120,0,40,0" VerticalAlignment="Center"  Text=""  Background="#FF444444" Foreground="#FFC3C3C3" SelectionBrush="#FF5B5B5B" BorderBrush="#FF444444" />


        <TextBlock HorizontalAlignment="Left" Grid.Row="2" Text="{x:Static lang:Strings.companyaddDes}" VerticalAlignment="Center" Margin="20,0,0,10" Foreground="#FFC3C3C3"   />
        <TextBlock HorizontalAlignment="Left" Margin="20,8,0,0" Grid.Row="3" Text="{x:Static lang:Strings.address}" Foreground="#FFC3C3C3" />
        <TextBox x:Name="companyaddress" Grid.Row="3"  Text="" Margin="120,0,40,0" VerticalAlignment="Center"   Background="#FF444444" Foreground="#FFC3C3C3" SelectionBrush="#FF5B5B5B" BorderBrush="#FF444444" />

        <TextBlock HorizontalAlignment="Left" Grid.Row="4"  TextWrapping="Wrap" Text="{x:Static lang:Strings.AppNumDescription}" VerticalAlignment="Top" Foreground="#FFC3C3C3" Margin="20,15,0,0"  />
        <TextBlock HorizontalAlignment="Left" Grid.Row="5" Margin="20,8,0,5" Text="{x:Static lang:Strings.Phone}"  Foreground="#FFC3C3C3" />
        <TextBox x:Name="companyPhone" Grid.Row="5"  Margin="120,0,40,0" Text="" VerticalAlignment="Center"  Background="#FF444444" Foreground="#FFC3C3C3" SelectionBrush="#FF5B5B5B" BorderBrush="#FF444444"  PreviewTextInput="companyPhone_PreviewTextInput"/>

        <TextBlock HorizontalAlignment="Left" Grid.Row="6" Margin="20,8,0,0" TextWrapping="Wrap" Text="{x:Static lang:Strings.Email}" VerticalAlignment="Top" Foreground="#FFC3C3C3" />
        <TextBox x:Name="companyEmail" Grid.Row="6"  Margin="120,0,40,0" Text="" VerticalAlignment="Center"  Background="#FF444444" Foreground="#FFC3C3C3" SelectionBrush="#FF5B5B5B" BorderBrush="#FF444444" />



        <PasswordBox x:Name="companyPassword" Grid.Row="8"  Margin="120,0,40,0" VerticalAlignment="Center"  Background="#FF444444" Foreground="#FFC3C3C3" SelectionBrush="#FF5B5B5B" BorderBrush="#FF444444" />
        <TextBlock Grid.Row="8" HorizontalAlignment="Left" Margin="20,8,0,0" Text="{x:Static lang:Strings.password}"  Foreground="#FFC3C3C3"/>
        <TextBlock HorizontalAlignment="Left" Grid.Row="7" Margin="20,2,0,5"  Text="{x:Static lang:Strings.EmailCompanycodegen}"  Foreground="#FFC3C3C3" />

        <TextBlock HorizontalAlignment="Left" Grid.Row="9" Margin="20,8,0,0" TextWrapping="Wrap" Text="{x:Static lang:Strings.Website}" VerticalAlignment="Top" Foreground="#FFC3C3C3" />
        <TextBox x:Name="companywebsite" Grid.Row="9"  Margin="120,0,40,0" Text="" VerticalAlignment="Center"  Background="#FF444444" Foreground="#FFC3C3C3" SelectionBrush="#FF5B5B5B" BorderBrush="#FF444444" />

        <TextBlock HorizontalAlignment="Left" Grid.Row="10" Margin="20,8,0,0" TextWrapping="Wrap" Text="{x:Static lang:Strings.WeatherLink}" VerticalAlignment="Top" Foreground="#FFC3C3C3" />
        <TextBox x:Name="weatheraddress" Grid.Row="10"  Margin="120,0,40,0" Text="" VerticalAlignment="Center"  Background="#FF444444" Foreground="#FFC3C3C3" SelectionBrush="#FF5B5B5B" BorderBrush="#FF444444" />


        <Button x:Name="BtnApply" Grid.Row="11" Content="{x:Static lang:Strings.Apply}" Height="28" HorizontalAlignment="Right" Margin="0,0,150,0"  Width="88" BorderThickness="1" BorderBrush="#555"  Click="BtnApply_Click"/>
        <Button x:Name="BtnCancel" Grid.Row="11" Content="{x:Static lang:Strings.Cancel}" Height="28" HorizontalAlignment="Right" Margin="0,0,40,0"  Width="100" BorderThickness="1" BorderBrush="#555" Click="BtnCancel_Click"/>


    </Grid>
</mah:MetroWindow>
