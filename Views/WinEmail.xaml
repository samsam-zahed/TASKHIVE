<mah:MetroWindow xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"  x:Class="testapps.Views.WinEmail"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="850"
                 Height="550"
                 WindowStartupLocation="CenterScreen" Loaded="MetroWindow_Loaded" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition x:Name="row5" Height="*"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>

        </Grid.RowDefinitions>

        <Label Content="{x:Static lang:Strings.From}" Grid.Row="1" Grid.Column="1"/>
        <TextBox x:Name="txtFrom" Text="" Grid.Row="1" Grid.Column="2" Height="30" Margin="20,0,20,0" BorderBrush="#555" IsReadOnly="True" />

        <Label Content="{x:Static lang:Strings.To}" Grid.Row="2" Grid.Column="1"/>
        <TextBox x:Name="txtTo" Text="" Grid.Row="2" Grid.Column="2" Height="30" Margin="20,0,20,0" BorderBrush="#555" IsReadOnly="True" />

        <Label Content="{x:Static lang:Strings.Subject}" Grid.Row="3" Grid.Column="1"/>
        <TextBox x:Name="txttitle" Text="title" Grid.Row="3" Grid.Column="2" Margin="20,0,20,0" Height="30" BorderBrush="#555" />
        <Wpf:WebView2 x:Name="browser" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Label Content="{x:Static lang:Strings.FileAttached}" Grid.Row="5" Grid.Column="1"/>
        <TextBox x:Name="txtfile" Text="" Grid.Row="5" Grid.Column="2" Margin="20,0,90,0" Height="30" BorderBrush="#555" IsReadOnly="True" />
        <Button x:Name="btnopenfile" Width="60" Content="&#xE723;" FontFamily="Segoe MDL2 Assets" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" Grid.Row="5" Margin="0,0,20,0" Click="btnopenfile_Click" />


        <Button x:Name="btnsend" Width="60" VerticalAlignment="Center" Content="&#xE724;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Grid.Column="2" Grid.Row="6" Margin="0,0,20,0" Click="btnsend_Click" />
    </Grid>
</mah:MetroWindow>
