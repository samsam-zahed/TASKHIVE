<mah:MetroWindow x:Class="testapps.Views.WinInternetMessageShow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="600"
                 Height="400"
                 WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="MetroWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                   
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label Content="{x:Static lang:Strings.sendmessagetouserinternet}" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="10"/>
                </Grid>

                
            </Grid>

       
            
            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <TextBlock x:Name="txtuser" Margin="20,0,0,0" Width="200" Height="25"/>
                <Button x:Name="btnselectuser" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="10,0,0,0" Click="btnselectuser_Click" />

                <Button x:Name="btnadd" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="10,0,0,0" Click="btnadd_Click" />
                <Button x:Name="btnedit" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="btnedit_Click"/>
                <Button x:Name="btndelete" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="btndelete_Click" />
                <Button x:Name="btnrefresh" Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="btnrefresh_Click"  />

            </StackPanel>

        </Grid>
        
        <Grid Grid.Row="1" Margin="10">

            <Grid.RowDefinitions>
              
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

       

            <DataGrid x:Name="UsersDataGrid" 
                     Grid.Row="0"
                                           
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            IsReadOnly="True"
                                            GridLinesVisibility="None"
                                            HeadersVisibility="Column"
                                       SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                       
                                            RowHeight="40"
                                            Margin="10"
                                            Background="#FF2D2D2D"
                                            Foreground="White"
                                            VirtualizingStackPanel.IsVirtualizing="False"
                                            BorderBrush="#FF4A4A4A" ColumnHeaderHeight="45"  CanUserResizeRows="False" SelectionChanged="UsersDataGrid_SelectionChanged">


                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#444"/>
                        <Setter Property="Foreground" Value="DarkGray"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="#666"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Blue"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Blue"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="{x:Static lang:Strings.ID}"
                            Width="40"
                            Binding="{Binding Id}" />

                    <DataGridTextColumn Header="{x:Static lang:Strings.RegistrationDate}"
                            Width="150"
                            Binding="{Binding dataRegister}" />

                    <DataGridTextColumn Header="{x:Static lang:Strings.description}"
                            Width="*"
                            Binding="{Binding describ}" />

                    <DataGridTextColumn Header="{x:Static lang:Strings.situation}"
                            Width="160"
                            Binding="{Binding ConditionMessage}" />



                    <!-- Situation column -->
                    <DataGridTemplateColumn Header="{x:Static lang:Strings.ReadUnread}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="16" Height="16"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding UserConfirm}" Value="True">
                                                    <Setter Property="Fill" Value="Green"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding UserConfirm}" Value="False">
                                                    <Setter Property="Fill" Value="Red"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                </DataGrid.Columns>

            </DataGrid>


        </Grid>


        <StatusBar Grid.Row="2" Background="#333" >
            <Label Content="{x:Static lang:Strings.totalcompanies}"/>
            <TextBlock x:Name="TextBlocCounts" VerticalAlignment="Center" HorizontalAlignment="Center" Text="0"/>
        </StatusBar>
        
    </Grid>
</mah:MetroWindow>
