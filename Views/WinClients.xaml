<mah:MetroWindow
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 mc:Ignorable="d" 
                 x:Name="WinUser" 
                 x:Class="testapps.Views.WinClients"
                 Title=""
           
                 WindowStartupLocation="CenterScreen" FontSize="14"  Background="#FF444444" BorderBrush="Gray"  ResizeMode="NoResize">

    <Grid x:Name="grid" Margin="20" Background="#FF444444"  >


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="60" />
            <RowDefinition Height="60"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3.2*"/>
            <ColumnDefinition Width="2.8*"/>
        </Grid.ColumnDefinitions>



        <Label x:Name="LabelClientID" Grid.Column="0" Grid.Row="1"  Content="ID"  Foreground="#FFB9B9B9" Margin="5"/>
        <TextBox x:Name="TextboxID" Grid.Column="1" Grid.Row="1"   Background="#FF3A3939" BorderBrush="#FF444444"   Margin="5" Foreground="#FFC1C1C1" MaxLength="9" PreviewTextInput="TextboxID_PreviewTextInput" />
        <Label x:Name="LabelClientIDNot" Grid.Column="2" Grid.Row="1"  Content="ID"  Foreground="#FFB9B9B9" Margin="5"/>


        <Label x:Name="LabelClientfname" Grid.Column="0" Grid.Row="2" Content="First Name" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxfname" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2"  Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" MaxLength="50" />

        <Label x:Name="LabelClientlname" Grid.Column="0" Grid.Row="3" Content="Last Name" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxlname" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"  Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" MaxLength="50" />

        <Label x:Name="LabelClientphone" Grid.Column="0" Grid.Row="4" Content="phone" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxphone" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="4"   Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" MaxLength="50" PreviewTextInput="Textboxphone_PreviewTextInput" DataObject.Pasting="PhoneTextBox_Pasting" />
        <Label x:Name="LabelClientnotphone" Grid.Column="2" Grid.Row="4" Content="phone" Foreground="#FFB9B9B9" Margin="5" />


        <Label x:Name="LabelClientaddress" Grid.Column="0" Grid.Row="5" Content="address" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxaddress" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="5" Grid.ColumnSpan="2"  Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" MaxLength="200" />

        <Label x:Name="LabelClientemail" Grid.Column="0" Grid.Row="6" Content="email" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxemail" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="6" Grid.ColumnSpan="2"  Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" MaxLength="100" />

        <Label x:Name="LabelClientage" Grid.Column="0" Grid.Row="7" Content="age" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxeage" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="7"   Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" MaxLength="3" PreviewTextInput="Textboxeage_PreviewTextInput" />

        <Label x:Name="LabelClienttelegram" Grid.Column="0" Grid.Row="8" Content="telegram" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxetelegram" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="8"   Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" MaxLength="30" PreviewTextInput="Textboxetelegram_PreviewTextInput" />
        <Label x:Name="LabelClientnottelegram" Grid.Column="2" Grid.Row="8" Content="telegram" Foreground="#FFB9B9B9" Margin="5" />


        <Label x:Name="LabelClienttesex" Grid.Column="0" Grid.Row="9" Content="Gender" Foreground="#FFB9B9B9" Margin="5" />
        <StackPanel  Grid.Column="1" Grid.Row="9" Orientation="Horizontal" >
            <RadioButton x:Name="RadioMale" Foreground="#FFC1C1C1" Content="{x:Static lang:Strings.Male}" Margin="0,10,8,0" Background="Transparent"/>
            <RadioButton x:Name="RadioFemale" Foreground="#FFC1C1C1" Content="{x:Static lang:Strings.Female}" Margin="0,10,8,0" Background="Transparent"/>
            <RadioButton x:Name="RadioOther" Foreground="#FFC1C1C1" Content="{x:Static lang:Strings.Other}" Margin="0,10,8,0" Background="Transparent"/>
            <RadioButton x:Name="Radiop" Foreground="#FFC1C1C1" Content="{x:Static lang:Strings.Prefernottosay}" Margin="0,10,8,0" IsChecked="True" Background="Transparent"/>
        </StackPanel>


  

        <Label x:Name="LabelClientnotsex" Grid.Column="2" Grid.Row="9" Content="Gender" Foreground="#FFB9B9B9" Margin="5" />


        <Label x:Name="LabelClienttenationality" Grid.Column="0" Grid.Row="10" Content="nationality" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxenationality" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="10"   Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" />

        <Label x:Name="LabelClientteimage" Grid.Column="0" Grid.Row="11" Content="image" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="Textboxeimage" IsReadOnly="True" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="11"   Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" />
        <Button x:Name="btnimage" Grid.Column="2" Grid.Row="11" Background="#FF3A3939" BorderBrush="#FF444444" Content="{x:Static lang:Strings.image}" Foreground="#FFEFEFEF" Margin="60,0,60,0" Click="btnimage_Click"  />

        <Label x:Name="LabelClienttesit" Grid.Column="0" Grid.Row="12" Content="situation" Foreground="#FFB9B9B9" Margin="5" />
        <StackPanel  Grid.Column="1" Grid.Row="12" Orientation="Horizontal" >
            <RadioButton x:Name="RadioTrue" Foreground="#FFC1C1C1" Content="{x:Static lang:Strings.True}" Margin="0,10,8,0" IsChecked="True" Background="Transparent"/>
            <RadioButton x:Name="RadioFalse" Foreground="#FFC1C1C1" Content="{x:Static lang:Strings.False}" Margin="0,10,8,0" Background="Transparent"/>
        </StackPanel>
        <Label x:Name="LabelClientnotsit" Grid.Column="2" Grid.Row="12" Content="situation" Foreground="#FFB9B9B9" Margin="5" />

        <Label x:Name="LabelClientteDes" Grid.Column="0" Grid.Row="13" Content="Des" Foreground="#FFB9B9B9" Margin="5" />
        <TextBox x:Name="TextboxeDes" Foreground="#FFC1C1C1" Grid.Column="1" Grid.Row="13" Grid.ColumnSpan="2" Grid.RowSpan="2"   Background="#FF3A3939" BorderBrush="#FF444444" Margin="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />

        <CheckBox x:Name="checkbox1" Grid.Column="1" Grid.Row="15" Content="CheckBox" HorizontalAlignment="Left" Foreground="#FFB9B9B9" Margin="8,0,0,0" VerticalAlignment="Center"/>


        <StackPanel x:Name="sc" Orientation="Horizontal" Grid.Column="2" Grid.Row="15" HorizontalAlignment="Right" >
            <Button x:Name="btnSave"  Background="#FF3A3939" BorderBrush="#FF444444" Content="save" Foreground="Gray" Width="150" Height="35" Margin="10,0,10,0" Click="btnSave_Click"  />
            <Button x:Name="btnCancel"  Background="#FF3A3939" BorderBrush="#FF444444" Content="cancel" Foreground="Gray" Width="150" Height="35" Click="btnCancel_Click" />

        </StackPanel>

        <Grid  >


        </Grid>




    </Grid>


</mah:MetroWindow>