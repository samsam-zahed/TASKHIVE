<mah:MetroWindow x:Class="testapps.Views.WinCalling"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="800"
                 Height="420"
                 WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FF373737" Loaded="MetroWindow_Loaded">
    
    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Grid.Column="0"  >



            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition Height="320"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock x:Name="txtEnterthephonenumberyouwant" TextWrapping="Wrap"  Text="{x:Static lang:Strings.Enterthephonenumberyouwant}" Foreground="#FFC1B5B5" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20" />
            </Grid>

            <Grid Grid.Row="1">

                <Label x:Name="labelphonenumber" Content="{x:Static lang:Strings.Phonenumber}" Foreground="#FFC1B5B5" Margin="20,5,10,5"/>
                    <TextBox x:Name="txtCall" Background="#333" Foreground="White" BorderBrush="#444" BorderThickness="1" Margin="20,40,20,5"  VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxLength="16"  PreviewTextInput="txtCall_PreviewTextInput"/>
                <Button x:Name="btncall" Content="&#xF715;" FontFamily="Segoe MDL2 Assets" Height="28" Width="80" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20,80,20,0"  Background="#333" Foreground="LightGreen" BorderBrush="#444" BorderThickness="1" Click="btncall_Click"/>

            </Grid>



        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid Grid.Column="1" >
                <Label x:Name="labelmessage" Content="{x:Static lang:Strings.Message}" Foreground="#FFC1B5B5"/>
                <TextBox x:Name="txtmessage" Text="" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" Foreground="White" Background="#333" BorderBrush="#444" BorderThickness="1" Margin="5,25,20,64"/>
                <Button x:Name="btnsend" Content="{x:Static lang:Strings.Sendmessage}" Width="100" Height="27" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#FFC1B5B5" BorderBrush="#555" Background="#333" BorderThickness="1" Margin="0,0,20,20" Click="btnsend_Click" />
            </Grid>

        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" >

            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>

                <RowDefinition Height="45"/>
            </Grid.RowDefinitions>

            <Label Content="{x:Static lang:Strings.Messages}" Grid.Row="0" Foreground="#FFC1B5B5" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
           
            <DataGrid x:Name="lvSMS" Grid.Row="1"
                                      
                                                                       
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            IsReadOnly="True"
                                            GridLinesVisibility="None"
                                            HeadersVisibility="Column"
                                       SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                       
                                            RowHeight="40"
                                          
                                            Background="#FF2D2D2D"
                                            Foreground="White"
                                            VirtualizingStackPanel.IsVirtualizing="False"
                                            BorderBrush="#FF4A4A4A" ColumnHeaderHeight="45"  CanUserResizeRows="False"
                                      
                                      
                                      Margin="20,2,20,20" SelectionChanged="lvSMS_SelectionChanged">


                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#444"/>
                        <Setter Property="Foreground" Value="DarkGray"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="#666"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="Blue"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Blue"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static lang:Strings.date}" Binding="{Binding Date}" Width="120" />
                    <DataGridTextColumn Header="{x:Static lang:Strings.Phone}" Binding="{Binding Address}" Width="110" />
                    <DataGridTextColumn Header="{x:Static lang:Strings.Message}" Binding="{Binding Body}" Width="220" />
                </DataGrid.Columns>

            </DataGrid>


            <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Center" Margin="20,0,0,0">
                <Label Content="{x:Static lang:Strings.TotalCount}" Foreground="#FFC1B5B5" />
                <Label x:Name="Lable_msgcount" Content="0"/>
            </StackPanel>

        </Grid>


    </Grid>
</mah:MetroWindow>
