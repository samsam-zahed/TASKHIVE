<mah:MetroWindow xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"  x:Class="testapps.Views.WinWebsite"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:testapps"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="600"
                 Height="400"
                     ShowTitleBar="False"
    ShowCloseButton="False"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="#333"
    Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Button x:Name="btnclose" Content="&#xE711;" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="HoloLens MDL2 Assets" Foreground="Red" Background="#333" BorderBrush="#444" BorderThickness="1" Click="btnclose_Click" />

        <Wpf:WebView2 x:Name="webbrowser1" Grid.Row="1" Margin="20"  />
        
        
    </Grid>
</mah:MetroWindow>
