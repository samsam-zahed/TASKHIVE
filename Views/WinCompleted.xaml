<mah:MetroWindow xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"  
                 x:Class="testapps.Views.WinCompleted"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="700"
                 Height="450"
                     ShowTitleBar="False"
    ShowCloseButton="False"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="#333"
     Loaded="MetroWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>


        <Label Grid.Row="1" Margin="20,7,20,9" Content="{x:Static lang:Strings.dessearchcompleted}" Foreground="White"/>

        <Button x:Name="btnclose" Grid.Row="0" Content="&#xE711;" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="HoloLens MDL2 Assets" Foreground="Red" Background="#000" BorderBrush="#555" BorderThickness="1" Click="btnclose_Click" />


        <TextBox x:Name="txtSearch" Margin="275,0,70,0" Grid.Row="2" Height="30" Foreground="#999" BorderBrush="#555" Background="#333"/>
        <ComboBox x:Name="comboSearch" Grid.Row="2" HorizontalAlignment="Left" Height="30" Width="250" Margin="20,0,0,0" SelectedIndex="1" Foreground="#999" BorderBrush="#555" Background="#333" >
            <ComboBoxItem Content="{x:Static lang:Strings.AssistanceServiceType}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.companyname}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.FindUserID}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.FullName}"/>
        </ComboBox>
        <Button x:Name="BtnFind" Grid.Row="2"  Width="35" Height="30"  Background="#444" BorderBrush="Gray" Foreground="White" HorizontalAlignment="Right" Margin="0,0,30,0" Click="BtnFind_Click" >

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets"  Text="&#xE721;" FontSize="12" Foreground="#FF5EC3ED"/>
            </StackPanel>

        </Button>



        <TextBox x:Name="txtfullname" Margin="20,0,70,0" Grid.Row="3" Height="30" IsReadOnly="True" Foreground="#999" BorderBrush="#555" Background="#333" />
        <Button x:Name="Btnprint" Grid.Row="3"  Width="35" Height="30"  Background="#444" BorderBrush="Gray" Foreground="White" HorizontalAlignment="Right" Margin="0,0,30,0" Click="Btnprint_Click" >

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets"  Text="&#xE749;" FontSize="12" Foreground="#FF5EC3ED"/>
            </StackPanel>

        </Button>



        <DataGrid x:Name="DataGridjobs" Grid.Row="4" 
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            IsReadOnly="True"
                                            GridLinesVisibility="None"
                                            HeadersVisibility="Column"
                                       SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                        
                                            RowHeight="40"
                                            Margin="20"
                                            Background="#FF2D2D2D"
                                            Foreground="White"
                                            VirtualizingStackPanel.IsVirtualizing="False"
                                            BorderBrush="#FF4A4A4A" ColumnHeaderHeight="45"  CanUserResizeRows="False" SelectionChanged="DataGridjobs_SelectionChanged" >


            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#444"/>
                    <Setter Property="Foreground" Value="DarkGray"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderBrush" Value="#666"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>


            <DataGrid.Columns>


                <DataGridTextColumn Header="{x:Static lang:Strings.ID}" Binding="{Binding idsub}" Width="100" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="{x:Static lang:Strings.date}" Binding="{Binding dayname}" Width="250">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">

                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="{x:Static lang:Strings.FullName}" Binding="{Binding customername}" Width="250">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="{x:Static lang:Strings.AssistanceServiceType}" Binding="{Binding jobcaption}" Width="500">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">

                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                </DataGridTextColumn>



                <DataGridTextColumn Header="{x:Static lang:Strings.description}" Binding="{Binding jobcomment}" Width="250" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="{x:Static lang:Strings.companyname}" Binding="{Binding CompanyName}" Width="300">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="{x:Static lang:Strings.Notes}" Binding="{Binding Notes1}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="{x:Static lang:Strings.Notes}" Binding="{Binding Notes2}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>


        </DataGrid>


        <StatusBar Grid.Row="5" Background="#444">
            <Label Content="{x:Static lang:Strings.TotalCount}" Foreground="White"/>
            <TextBox x:Name="txtcount" Text="0" Foreground="White" Background="Transparent" BorderBrush="#444" BorderThickness="1"/>
        </StatusBar>

    </Grid>
</mah:MetroWindow>
