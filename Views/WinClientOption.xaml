<mah:MetroWindow
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                 mc:Ignorable="d" x:Name="WinUser" x:Class="testapps.Views.WinClientOption"
                 Title=""
                Height="400"
                 Width="850"
                 WindowStartupLocation="CenterScreen" FontSize="14"  Background="#FF444444"  ResizeMode="NoResize" Loaded="WinUser_Loaded">


    <Grid x:Name="grid" Margin="20" Background="#FF444444" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>

        </Grid.RowDefinitions>



        <CheckBox x:Name="CheckBoxFrom" Content="{x:Static lang:Strings.StartdateEnddate}" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="5,0,5,0"/>

        <DatePicker x:Name="DateFrom"  Grid.Column="1" Grid.Row="0" VerticalAlignment="Center"  />
        <DatePicker x:Name="DateTo"  Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" Margin="5,0,0,0" />


        <CheckBox x:Name="CheckBoxCaption" Content="{x:Static lang:Strings.AssistanceServiceType}" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" Margin="5,0,5,0"/>
        <ComboBox x:Name="ComboBoxCaption" Grid.Row="1" Grid.Column="1"  VerticalAlignment="Center" >
            <ComboBoxItem Content="{x:Static lang:Strings.HousingShelterServices}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.HealthMedicalServices}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.EducationLanguageServices}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.LegalImmigrationServices}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.EmploymentVocationalServices}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.SocialCulturalIntegrationServices}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.EmergencyCrisis_Services}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.OtherExtraCrisisServices}"/>
        </ComboBox>

        <CheckBox x:Name="CheckBoxCondition" Content="{x:Static lang:Strings.ServiceStatus}" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Margin="5,0,5,0"/>
        <ComboBox x:Name="ComboBoxCondition" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" >
            <ComboBoxItem Content="{x:Static lang:Strings.NotStarted}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.Ongoing}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.Completed}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.Blocked}"/>
        </ComboBox>

        <CheckBox x:Name="CheckBoxResponsible" Content="{x:Static lang:Strings.ServiceWorker}" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" Margin="5,0,5,0"/>
        <ComboBox x:Name="ComboBoxResponsible" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" />

        <CheckBox x:Name="CheckBoxEnable" Content="{x:Static lang:Strings.Enabledisableservicestatus}" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" Margin="5,0,5,0"/>
        <ComboBox x:Name="ComboBoxEnable" Grid.Column="1" Grid.Row="4" VerticalAlignment="Center" >
            <ComboBoxItem Content="{x:Static lang:Strings.Active}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.Inactive}"/>
        </ComboBox>

        <CheckBox x:Name="CheckBoxTextSearch" Grid.Column="0" Grid.Row="5" Content="{x:Static lang:Strings.Searchcustomerby}" VerticalAlignment="Center" Margin="5,0,5,0"/>
        <ComboBox x:Name="ComboBoxTextSearch" SelectedIndex="1" Grid.Column="1" Grid.Row="5" VerticalAlignment="Center" Margin="5,0,5,0" BorderBrush="#444" >
            <ComboBoxItem Content="{x:Static lang:Strings.ID}"/>
            <ComboBoxItem Content="{x:Static lang:Strings.lname}"/>
        </ComboBox>
        <TextBox x:Name="TextBoxSearch" Grid.Column="2" Grid.Row="5" VerticalAlignment="Center" Margin="5,0,5,0" BorderBrush="#444" />


        <CheckBox x:Name="CheckBoxTime" Content="{x:Static lang:Strings.Time}" Grid.Column="0" Grid.Row="6" VerticalAlignment="Center" Margin="5,0,5,0"/>
        <TextBox x:Name="TextBoxTime" HorizontalAlignment="Left"  Text="00:00" TextAlignment="Center" VerticalAlignment="Center"  PreviewTextInput="TextBoxTime_PreviewTextInput" Grid.Column="1" Grid.Row="6"  />


        <Button x:Name="ButtonSearch" Grid.Row="7" Grid.Column="2" Content="{x:Static lang:Strings.Search}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="180,0,0,0" BorderBrush="#555" Click="ButtonSearch_Click" />
        <Button x:Name="btncancle" Grid.Row="7" Grid.Column="2" Content="{x:Static lang:Strings.Cancel}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" BorderBrush="#555" Click="btncancle_Click"/>

    </Grid>

</mah:MetroWindow>

    