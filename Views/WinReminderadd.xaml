<mah:MetroWindow xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 x:Class="testapps.Views.WinReminderadd"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="850"
                 Height="400"
                 WindowStartupLocation="CenterScreen"  >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
     
            <RowDefinition Height="65"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        

        </Grid.RowDefinitions>


        <Label Content="{x:Static lang:Strings.ReminderAdddes}" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Margin="20"/>


        <Label Content="{x:Static lang:Strings.ReminderDateTime}" Grid.Column="1" Grid.Row="1"/>




        <Grid x:Name="MyDatePicker" Width="150" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" Margin="10,0,0,0" >
            <TextBox x:Name="MyDatetextbox" IsReadOnly="True"  Padding="2,7,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FF292929" Foreground="#FF7FFF74" BorderBrush="#FF292929" BorderThickness="2"/>
            <Button x:Name="MybuttonDate" Content="&#xE712;" Width="30" Height="40" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Center" >

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF4C4C4C"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                </Button.Style>


            </Button>
            <Popup x:Name="mypopup" PlacementTarget="{Binding ElementName=MyDatetextbox}" StaysOpen="False" >
                <Calendar x:Name="MyCalender" />
            </Popup>
        </Grid>

        <TextBox x:Name="txttime" Width="100" Text="00:00" TextAlignment="Center" Foreground="White" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" Margin="165,0,0,0" Padding="7" PreviewTextInput="txttime_PreviewTextInput" LostFocus="txttime_LostFocus"/>
        <TextBox x:Name="txtreachdes" AcceptsReturn="True" TextWrapping="Wrap" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" Foreground="White" Margin="20" BorderThickness="1" BorderBrush="#333" VerticalScrollBarVisibility="Visible"  />

        <CheckBox x:Name="checkbox1" Grid.Row="3" Grid.Column="1" Content="{x:Static lang:Strings.situation}" VerticalAlignment="Top" Margin="20,0,0,0" IsChecked="True" />

        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,20,0">
            <Button x:Name="btnsave" Width="90" Height="35" Content="{x:Static lang:Strings.Save}" Margin="0,0,10,0" Click="btnsave_Click"/>
            <Button x:Name="btncancel" Width="110" Height="35" Content="{x:Static lang:Strings.Cancel}" Click="btncancel_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
