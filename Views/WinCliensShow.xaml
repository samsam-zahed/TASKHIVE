<mah:MetroWindow x:Class="testapps.Views.WinCliensShow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="600"
                 Height="400"
                 WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="MetroWindow_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Label Content="{x:Static lang:Strings.Customerwinforminfo}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" />

                </Grid>

                <Grid Grid.Column="1" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <Label Content="{x:Static lang:Strings.addexcel}" VerticalAlignment="Center" Grid.Row="0"  />
                    <Button x:Name="btnExcelTemplate" Foreground="LightBlue" Content="&#xED0E;" FontFamily="Segoe MDL2 Assets" Width="25" HorizontalAlignment="Right" Height="25" Margin="20,0,20,0" BorderBrush="#222" Grid.Row="0" Click="btnExcelTemplate_Click"/>



                    <Label Content="{x:Static lang:Strings.Importexcelfile}" VerticalAlignment="Center" Grid.Row="1" />
                    <Button x:Name="btnExcelAdd" Foreground="LightBlue" Content="&#xF571;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" Width="25" Height="25" BorderBrush="#222" Grid.Row="1" Margin="20,0,20,0" Click="btnExcelAdd_Click"/>
                

                </Grid>
                
            </Grid>

       
            
            <StackPanel Orientation="Horizontal" Grid.Row="1">
                <Button x:Name="btnadd" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="20,0,0,0" Click="btnadd_Click" />
                <Button x:Name="btnedit" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="btnedit_Click"/>
                <Button x:Name="btndelete" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="btndelete_Click" />
                <Button x:Name="btnprint" Content="&#xE749;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="btnprint_Click" />
                <Button x:Name="btnrefresh" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="btnrefresh_Click"  />
                <Button x:Name="btninactivecustomers" Content="&#xE8F8;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="btninactivecustomers_Click" />

            </StackPanel>

        </Grid>
        
        <Grid Grid.Row="1" Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <ComboBox x:Name="combo1" Width="150" HorizontalAlignment="Left" SelectedIndex="1" Margin="10,0,0,0">
                    <ComboBoxItem x:Name="comboboxclientItemID" Content="{x:Static lang:Strings.ID}" />
                    <ComboBoxItem x:Name="comboboxclientItemfname" Content="{x:Static lang:Strings.fname}" />
                    <ComboBoxItem x:Name="comboboxclientItemlname" Content="{x:Static lang:Strings.lname}" />
                    <ComboBoxItem x:Name="comboboxclientItemphone" Content="{x:Static lang:Strings.Phone}" />
                    <ComboBoxItem x:Name="comboboxclientItemage" Content="{x:Static lang:Strings.age}" />
                    <ComboBoxItem x:Name="comboboxclientItemgender" Content="{x:Static lang:Strings.gender}" />
                    <ComboBoxItem x:Name="comboboxclientItemnational" Content="{x:Static lang:Strings.nationality}" />
                </ComboBox>
                <TextBox x:Name="textboxsearch" BorderBrush="#333" BorderThickness="1"  Padding="5" Margin="2,0,10,0" Text="Type your value" Foreground="Gray" TextChanged="textboxsearch_TextChanged" GotFocus="textboxsearch_GotFocus" LostFocus="textboxsearch_LostFocus"/>
            </DockPanel>

            <DataGrid x:Name="ClientsDataGrid" Grid.Row="1"
                                           
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            CanUserDeleteRows="False"
                                            IsReadOnly="True"
                                            GridLinesVisibility="None"
                                            HeadersVisibility="Column"
                                       SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                               ItemsSource="{Binding Clients}"
                                            RowHeight="80"
                                            Margin="10"
                                            Background="#FF2D2D2D"
                                            Foreground="White"
                                            VirtualizingStackPanel.IsVirtualizing="False"
                                            BorderBrush="#FF4A4A4A" ColumnHeaderHeight="45"  CanUserResizeRows="False" SelectionChanged="ClientsDataGrid_SelectionChanged" >


                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#444"/>
                        <Setter Property="Foreground" Value="DarkGray"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="BorderBrush" Value="#666"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>


 




                <DataGrid.Columns>


                    <DataGridTextColumn x:Name="GridHeaderID" Header="{x:Static lang:Strings.ID}" Width="80"
                              Binding="{Binding id}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTemplateColumn x:Name="GridHeaderImage" Header="{x:Static lang:Strings.image}" Width="80" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FF4A4A4A"
                                                BorderThickness="1"
                                                Margin="5">
                                    <Image Source="{Binding image}" 
                                                Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="GridHeaderFname" Header="{x:Static lang:Strings.fname}" Width="110"
                                Binding="{Binding fname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>




                    <DataGridTextColumn x:Name="GridHeaderLname" Header="{x:Static lang:Strings.lname}" Width="140"
                           Binding="{Binding lname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn x:Name="GridHeaderPhone" Header="{x:Static lang:Strings.Phone}" Width="100"
                               Binding="{Binding phone}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn x:Name="GridHeaderAge" Header="{x:Static lang:Strings.age}" Width="80"
                             Binding="{Binding age}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn x:Name="GridHeaderNational" Header="{x:Static lang:Strings.nationality}" Width="160"
                           Binding="{Binding nationality}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn x:Name="GridHeaderGender" Header="{x:Static lang:Strings.gender}" Width="160"
                                             Binding="{Binding personeltype}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn x:Name="GridHeaderTelID" Header="{x:Static lang:Strings.TelegramID}" Width="120"
                        Binding="{Binding idtelegram}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn x:Name="GridHeaderEmail" Header="{x:Static lang:Strings.Email}" Width="250"
                         Binding="{Binding myemail}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>





                    <DataGridTextColumn x:Name="GridHeaderAddress" Header="{x:Static lang:Strings.address}" Width="300"
                              Binding="{Binding address}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn x:Name="GridHeaderdes" Header="{x:Static lang:Strings.description}" Width="550"
                                       Binding="{Binding des}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>

                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                </DataGrid.Columns>

            </DataGrid>



        </Grid>


        <StatusBar Grid.Row="2" Background="#333" >
            <Label Content="{x:Static lang:Strings.totalclients}"/>
            <TextBlock x:Name="TextBlocCounts" Width="150"/>
        </StatusBar>
        
    </Grid>
</mah:MetroWindow>
