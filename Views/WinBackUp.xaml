<mah:MetroWindow x:Class="testapps.Views.WinBackUp"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="600"
                 Height="470"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <TextBlock TextWrapping="Wrap" Text="{x:Static lang:Strings.backupdes}" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#999" Margin="35,0,10,0"/>
        <RadioButton x:Name="radiobackup" Content="{x:Static lang:Strings.Backup}" Grid.Row="1" Foreground="White" />
     
        <Label Content="{x:Static lang:Strings.FilePath}" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,45"/>
        <TextBox x:Name="txtbackuppath" Grid.Row="2" VerticalAlignment="Bottom"  Margin="100,0,35,45" IsReadOnly="True"/>
      
        <Label Content="{x:Static lang:Strings.FileName}" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        <TextBox x:Name="txtbackfilename" Grid.Row="2" VerticalAlignment="Bottom"  Margin="100,0,35,12" />

        <Button x:Name="btnopenfile" Grid.Row="2" Content="&#xE8E5;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,45" Click="btnopenfile_Click" />


        <RadioButton x:Name="radiorestore" Content="{x:Static lang:Strings.Restore}" Grid.Row="3" Foreground="White" />
        
        <TextBlock TextWrapping="Wrap" Text="{x:Static lang:Strings.Restoreded}" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#999" Margin="35,0,10,0"/>

        <Label Content="{x:Static lang:Strings.FilePath}" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,40"/>
        <TextBox x:Name="txtRestorepath" Grid.Row="4" VerticalAlignment="Bottom"  Margin="100,0,35,40" IsReadOnly="True"/>
        <Button x:Name="btnopenfilerestore" Grid.Row="4" Content="&#xE8E5;" Margin="0,0,7,41" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="btnopenfilerestore_Click"   />




        <StackPanel Orientation="Horizontal" Grid.Row="5" HorizontalAlignment="Right" Margin="0,0,20,0">
            <Button x:Name="btnsave" Content="{x:Static lang:Strings.Backup}" VerticalAlignment="Center" Width="80" Height="27" Click="btnsave_Click"/>
            <Button x:Name="btncancel" Content="{x:Static lang:Strings.Cancel}" VerticalAlignment="Center" Width="100" Height="27" Margin="5,0,5,0" Click="btncancel_Click"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>
