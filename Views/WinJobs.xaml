<mah:MetroWindow x:Class="testapps.Views.WinJobs"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                
                 Title=""
                 Width="1200"
                 Height="400"
                 WindowStartupLocation="CenterScreen" BorderBrush="Gray" WindowState="Maximized" Loaded="MetroWindow_Loaded" >




    <Grid Background="#FF333333">

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Top">
            <DockPanel Grid.Row="0">




            </DockPanel>
        </Grid>



        <Grid x:Name="Middle" Grid.Row="1">


          


            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">

                    <ToolBar Name="toolbar1" Background="#FF292929" Foreground="White">

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">

                            <Button x:Name="btnadd" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="10,0,0,0" Click="BtnAdd_Click" />
                            <Button x:Name="btnedit" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="BtnEdit_Click"/>
                            <Button x:Name="btndelete" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="BtnDelete_Click" />
                            <Button x:Name="btndrefresh" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="Btnrefresh_Click" />
                            <Button x:Name="btndrePrint" Content="&#xE749;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="BtnrePrint_Click" />


                            <Line X1="0" Y1="0" X2="0" Y2="50" Stroke="Gray" StrokeThickness="1" Margin="10,0,0,0"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,10,0">
                                <Label x:Name="LabelFilter" Content="{x:Static lang:Strings.ServiceStatus}" VerticalAlignment="Center" Foreground="White" />
                                <ComboBox x:Name="ComboboxConditionJob" Width="150" Margin="2" SelectedIndex="0" SelectionChanged="ComboboxConditionJob_SelectionChanged">
                                    <ComboBoxItem Content="{x:Static lang:Strings.NotStarted}"/>
                                    <ComboBoxItem Content="{x:Static lang:Strings.Ongoing}"/>
                                    <ComboBoxItem Content="{x:Static lang:Strings.Completed}"/>
                                    <ComboBoxItem Content="{x:Static lang:Strings.Blocked}"/>
                                </ComboBox>


                                <Label Content="{x:Static lang:Strings.Inactiveusers}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <Button x:Name="btnstatus" Content="&#xE8F8;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="Btnstatus_Click" />

                                <Label Content="{x:Static lang:Strings.Search}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                <Button x:Name="btnsearch" Content="&#xE721;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="Btnsearch_Click" />
                                <Button x:Name="btnInternetMessage" Content="&#xE8CA;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Foreground="LightBlue" BorderBrush="#222" Margin="2,0,0,0" Click="Btnselectuser_Click" />

                            </StackPanel>

                        </StackPanel>

                        <Line X1="0" Y1="0" X2="0" Y2="50" Stroke="Gray" StrokeThickness="1" />

                     
                    </ToolBar>


                </DockPanel>


                <DataGrid x:Name="DataGridjobs" Grid.Row="1" 
                          
                                                                       AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     CanUserDeleteRows="False"
                                     IsReadOnly="True"
                                     GridLinesVisibility="None"
                                     HeadersVisibility="Column"
                                SelectionMode="Extended"
                                SelectionUnit="FullRow"
                               
                                     RowHeight="40"
                                     Margin="10"
                                     Background="#FF2D2D2D"
                                     Foreground="White"
                                     VirtualizingStackPanel.IsVirtualizing="False"
                                     BorderBrush="#FF4A4A4A" ColumnHeaderHeight="45"  CanUserResizeRows="False" SelectionChanged="DataGridjobs_SelectionChanged"   >


                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#444"/>
                            <Setter Property="Foreground" Value="DarkGray"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="#666"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Blue"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Blue"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>

                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>







                    <DataGrid.Columns>


                        <DataGridTextColumn Header="{x:Static lang:Strings.ID}" Binding="{Binding id}" Width="100" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTextColumn Header="{x:Static lang:Strings.ServiceUser}" Binding="{Binding customername}" Width="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTextColumn Header="{x:Static lang:Strings.AssistanceServiceType}" Binding="{Binding jobcaption}" Width="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTextColumn Header="{x:Static lang:Strings.description}" Binding="{Binding jobcomment}" Width="500">

                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">

                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>



                        <DataGridTextColumn Header="{x:Static lang:Strings.ServiceStatus}" Binding="{Binding jobsit}" Width="250" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTextColumn Header="{x:Static lang:Strings.ServiceWorker}" Binding="{Binding jobduty}" Width="300">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTextColumn Header="{x:Static lang:Strings.Time}" Binding="{Binding jobtime}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>


                        <DataGridTextColumn Header="{x:Static lang:Strings.ServiceUserID}" Binding="{Binding iduser}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>


                </DataGrid>


            </Grid>



        </Grid>




        <Grid x:Name="Down" Grid.Row="2">

            <DockPanel >

            </DockPanel>

        </Grid>
    </Grid>
</mah:MetroWindow>
