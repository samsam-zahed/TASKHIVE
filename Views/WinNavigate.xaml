<mah:MetroWindow x:Class="testapps.Views.WinNavigate"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:lang="clr-namespace:TaskHive"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title=""
                 Width="700"
                 Height="300"
                 ResizeMode="NoResize"
                 Topmost="True"
                 WindowStartupLocation="CenterScreen" Loaded="MetroWindow_Loaded">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static lang:Strings.NavigateDes}" Foreground="#999" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" Grid.Row="0" Margin="20,0,0,0" />


        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,15">
            <Button x:Name="btn2" Content="{x:Static lang:Strings.CompanyAddress}"   HorizontalAlignment="Right"  BorderBrush="#555" Height="28" Margin="0,0,5,4" Click="btn2_Click"/>
            <Button x:Name="btn1" Content="{x:Static lang:Strings.customeraddress}"   HorizontalAlignment="Right"  BorderBrush="#555" Height="28" Margin="0,0,5,4" Click="btn1_Click"/>
            <Button x:Name="btn3" Content="{x:Static lang:Strings.OfficeAddress}"   HorizontalAlignment="Right"  BorderBrush="#555" Height="28" Margin="0,0,5,4" Click="btn3_Click"/>

        </StackPanel>


        <Label Content="{x:Static lang:Strings.address}" Grid.Row="1" />
        <Label Content="1" Grid.Row="1" Margin="50,0,0,0" HorizontalAlignment="Left" />
        <TextBox x:Name="txtaddress1" Grid.Row="1" Margin="75,0,60,4" VerticalAlignment="Center" BorderBrush="#555" GotFocus="txtaddress1_GotFocus" />
        <Button x:Name="BtnNavigateChange" Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Right" Margin="5,0,15,0" Content="&#xE8CB;" FontFamily="Segoe MDL2 Assets" Width="35" Height="35" Foreground="LightBlue" BorderBrush="#444"  Click="BtnNavigateChange_Click"/>



        <Label Content="{x:Static lang:Strings.address}" Grid.Row="3" />
        <Label Content="2" Grid.Row="3" Margin="50,0,0,0" HorizontalAlignment="Left" />
        <TextBox x:Name="txtaddress2" Grid.Row="3" Margin="75,0,60,4" VerticalAlignment="Center" BorderBrush="#555" GotFocus="txtaddress2_GotFocus" />

        <StackPanel Orientation="Horizontal" Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="btnnavigate" Content="{x:Static lang:Strings.navigate}"  HorizontalAlignment="Right" Width="98" BorderBrush="#555" Height="28" Margin="0,0,5,4" Click="btnnavigate_Click"/>
        <Button x:Name="btncancel" Content="{x:Static lang:Strings.Cancel}"  HorizontalAlignment="Right" Width="68" BorderBrush="#555" Height="28" Margin="0,0,5,4" Click="btncancel_Click"/>
        </StackPanel>

    </Grid>
</mah:MetroWindow>
